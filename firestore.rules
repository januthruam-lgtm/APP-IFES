rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // 0. Health check de conectividade do Firestore
    match /test/{docId} {
      allow read: if true;
    }

    // 1. Boletins: leitura pelo dono (ou aberto em modo preview), escrita via sync
    match /boletins/{uid} {
      allow read: if isOwner(uid) || !isAuthenticated();
      allow write: if isOwner(uid) || !isAuthenticated();
    }

    // 2. Credenciais Q-Acadêmico (apenas matrícula e campus, NUNCA senha)
    match /credenciaisQAcademico/{uid} {
      allow read, write: if isOwner(uid) || !isAuthenticated();
    }

    // 3. Saldos de gamificação (moedas, XP e nível com atualização atômica)
    match /saldos/{uid} {
      allow read, write: if true;
    }

    // 4. Pets do Usuário (leitura aberta, escrita pelo estudante)
    match /petsUsuario/{uid} {
      allow read: if true;
      allow write: if isOwner(uid) || !isAuthenticated();
    }

    // 5. Equipes e Fóruns Acadêmicos em Tempo Real
    match /equipes/{equipeId} {
      allow read, write: if true;
      match /mensagens/{mensagemId} {
        allow read, write: if true;
      }
      match /typing/{userId} {
        allow read, write: if true;
      }
    }

    // 5b. Chats Individuais Diretos (1-on-1 Real-time Messaging com Visto e Digitando)
    match /directChats/{chatId} {
      allow read, write: if true;
      match /messages/{messageId} {
        allow read, write: if true;
      }
      match /typing/{userId} {
        allow read, write: if true;
      }
    }

    // 6. Presença e Heartbeat
    match /presencas/{uid} {
      allow read, write: if true;
    }

    // 7. Notificações Unificadas
    match /notificacoes/{notifId} {
      allow read, write: if true;
    }

    // 8. Dados do Usuário e Memória da Lumina
    match /users/{uid} {
      allow read, write: if isOwner(uid) || !isAuthenticated();
      match /credentials/{credType} {
        allow read, write: if isOwner(uid) || !isAuthenticated();
      }
      match /luminaMemoria/{memoriaId} {
        allow read, delete: if isOwner(uid) || !isAuthenticated();
        allow write: if isOwner(uid) || !isAuthenticated();
      }
      // Sistemas Institucionais Conectados: Proibição estrita de tokens e senhas no Firestore
      match /sistemas/{sistemaId} {
        allow read: if isOwner(uid) || !isAuthenticated();
        allow write: if (isOwner(uid) || !isAuthenticated())
          && !('token' in request.resource.data)
          && !('password' in request.resource.data)
          && !('senha' in request.resource.data);
      }
      // Livro-Razão Contábil de Moedas (Append-only: imutável e sem recompensa de tarefas)
      match /extrato/{lancamentoId} {
        allow read: if isOwner(uid) || !isAuthenticated();
        allow create: if (isOwner(uid) || !isAuthenticated())
          && request.resource.data.valor is number
          && request.resource.data.valor >= 0
          && request.resource.data.tipo in ['ganho', 'gasto', 'cashback', 'ajuste']
          && request.resource.data.origem != 'tarefa';
        allow update, delete: if false;
      }
      // Programa de Fidelidade Acadêmica
      match /fidelidade/{docId} {
        allow read, write: if isOwner(uid) || !isAuthenticated();
      }
    }

    // 10. Biblioteca Virtual Aberta (Apenas obras ativas com licença auditada)
    match /biblioteca/{obraId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 11. Instituições Pendentes (Moderação de novos cadastros manuais)
    match /instituicoesPendentes/{instId} {
      allow read: if !isAuthenticated() || (resource != null && resource.data.criadoPorUid == request.auth.uid);
      allow create: if request.resource.data.nome is string
        && !('token' in request.resource.data)
        && !('senha' in request.resource.data);
      allow update, delete: if false;
    }

    // 12. Instituições Aprovadas (Alimenta busca pública sem recriar arquivos)
    match /instituicoesAprovadas/{instId} {
      allow read: if true;
      allow write: if false; // Somente via scripts administrativos autorizados
    }
  }
}
