# a segurança real dos dados reside nas Regras de Segurança do Firestore e App Check.
VITE_FIREBASE_PROJECT_ID="total-melody-g6rpq"
VITE_FIREBASE_APP_ID="1:379369360491:web:a6a3e840e9a75048f1752e"
VITE_FIREBASE_API_KEY=""
