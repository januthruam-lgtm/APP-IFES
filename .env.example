# IMPORTANTE:
# 1. NUNCA faça commit de arquivos .env com valores reais para o repositório.
# 2. Chaves de API e segredos confidenciais NUNCA devem ser colocados no cliente.
# 3. No Google Cloud Run / AI Studio, variáveis são injetadas com segurança no ambiente.
# ==============================================================================

# API Gemini (Google Generative AI) - Usado exclusivamente no backend (server.ts / scripts)
GEMINI_API_KEY=""

# URL Base da Aplicação (usada para self-referential links, PWA e webhooks)
APP_URL="https://ais-dev-pzvdq3wll2wmaa436tu5nt-801563813870.us-east1.run.app"

# Porta do Servidor Node / Express (Padrão 3000)
PORT=3000

# Fuso Horário de Referência para fechamento diário da economia (America/Sao_Paulo)
TZ="America/Sao_Paulo"

# Web Push VAPID Keys (Notificações Acadêmicas)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@brainstudio.app"

# Configuração do Firebase Client (Chaves públicas de roteamento do SDK Web)
