{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "build:native": "npm run clean && vite build && npx cap sync android",
    "android:open": "npx cap open android",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "test": "tsx scripts/test-streak.ts && tsx scripts/test-regras.ts && tsx scripts/test-tombstones.ts && tsx scripts/test-economia-fluxo.ts && tsx scripts/test-multi-instituicao.ts && tsx scripts/test-cidades-idiomas.ts && tsx scripts/test-i18n-rtl.ts && tsx scripts/test-extrato-concorrencia.ts && tsx scripts/test-notificacoes.ts && tsx scripts/test-agenda-materias.ts && tsx scripts/test-metodos-estudo.ts",
    "test:instituicao": "tsx scripts/test-multi-instituicao.ts",
    "test:cidades": "tsx scripts/test-cidades-idiomas.ts",
    "test:regras": "tsx scripts/test-regras.ts",
    "test:tombstones": "tsx scripts/test-tombstones.ts",
    "test:economia": "tsx scripts/test-economia-fluxo.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
